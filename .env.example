TELEGRAM_BOT_TOKEN=replace_me
OPENAI_API_KEY=replace_me

# Optional: use non-default model
CHAT_MODEL=gpt-4o-mini

# Web app
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./crm.db

# Telephony integrations (optional for MVP)
ZADARMA_KEY=
ZADARMA_SECRET=
# For callback API use PBX internal extension/scenario (often 100), not phone number.
ZADARMA_FROM=
# Optional PBX scenario id for AI-call flow (from will be sent as 0-<id>)
ZADARMA_SCENARIO_ID=
# Caller ID: номер із кабінету «Ваші номери» (наприклад +380...)
ZADARMA_CALLER_ID=
# SIP номер з колонки «SIP номер» (наприклад 98420)
ZADARMA_SIP=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
TELEPHONY_PROVIDER=zadarma
# Публічний HTTPS без завершального слеша (код сам нормалізує)
PUBLIC_BASE_URL=http://localhost:8000

# Optional admin auth (simple header-based guard in MVP)
ADMIN_TOKEN=change_this_token
ADMIN_EMAIL=tov.https@gmail.com
ADMIN_PASSWORD=change_this_password
