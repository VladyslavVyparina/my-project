# Скопіюйте цей файл у credentials.env і заповніть значення.
# Потім запустіть: sudo bash apply.sh

# Публічний IP цього VPS (визначити: curl -4 -s https://ipinfo.io/ip)
PUBLIC_IP=173.242.58.156

# SIP-логін з кабінету Zadarma -> Налаштування -> SIP (приклад: 98420 або 98420-100).
# Це НЕ API-ключ і НЕ ID акаунту, а саме SIP login.
ZADARMA_SIP_USER=

# SIP-пароль з того ж розділу (Show password / Згенерувати).
# Це НЕ API-секрет, НЕ пароль від кабінету.
ZADARMA_SIP_PASSWORD=

# CallerID — ваш номер у форматі 380XXXXXXXXX (без плюса).
ZADARMA_CALLERID=380931775053

# Пароль, який ElevenLabs буде використовувати для авторизації на нашому проксі.
# Придумайте 20+ випадкових символів.
ELEVENLABS_TRUNK_PASSWORD=
